#!/usr/bin/env bash
# streamlab: drive a Wolf host and a Moonlight client host over ssh.
# usage: streamlab guard HOST... | pair ... | run ... | game VERB ... | parse LOG
set -euo pipefail

# Wolf API field names, from the live openapi-schema. Fix here only.
WOLF_SOCK=/run/wolf/wolf.sock
JQ_PENDING_LIST='.requests[]'
JQ_PENDING_IP='.client_ip'
JQ_PENDING_SECRET='.pair_secret'
PAIR_BODY_SECRET=pair_secret
PAIR_BODY_PIN=pin

GATE=/var/usrlocal/bin/wolf-idle-gate.sh
IMAGE=${STREAMLAB_IMAGE:-registry.gitlab.com/dunn.dev/streamlab/client:latest}
STATE_DIR=/var/lib/streamlab
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)

die() { echo "streamlab: $*" >&2; exit 1; }

remote() { # host cmd...
  local h=$1
  shift
  # shellcheck disable=SC2029
  ssh "${SSH_OPTS[@]}" "$h" "$@"
}

guard() {
  local h
  [ $# -gt 0 ] || die "guard: no hosts"
  for h in "$@"; do
    remote "$h" "sudo -n $GATE idle" >/dev/null 2>&1 \
      || die "guard: $h is not idle or the gate failed; aborting"
  done
}

# Prints the stats and decoder columns for one moonlight stderr log.
PARSE_COLS='WxH	fps_in	fps_dec	fps_render	host_lat_avg	net_drop_pct	jitter_drop_pct	rtt	decode_ms	queue_ms	render_ms	codec	decoder'

parse() {
  local log=${1:-}
  [ -r "$log" ] || die "parse: cannot read '$log'"
  printf '%s\n' "$PARSE_COLS"
  awk -v q="'" '
    function after(label,   i, rest) {
      i = index($0, label)
      if (i == 0) return ""
      rest = substr($0, i + length(label))
      if (match(rest, /[0-9]+(\.[0-9]+)?/)) return substr(rest, RSTART, RLENGTH)
      return ""
    }
    function hostavg(   i, rest, a) {
      i = index($0, "min/max/average:")
      rest = substr($0, i + 16)
      if (split(rest, a, "/") < 3) return ""
      if (match(a[3], /[0-9]+(\.[0-9]+)?/)) return substr(a[3], RSTART, RLENGTH)
      return ""
    }
    BEGIN {
      fmt["0x1"] = "H.264"; fmt["0x100"] = "HEVC"; fmt["0x200"] = "HEVC-Main10"
      fmt["0x1000"] = "AV1"; fmt["0x2000"] = "AV1-Main10"
    }
    /Global video stats/ { inb = 1; seen = 1; next }
    /Video stream is [0-9]+x[0-9]+/ {
      if (match($0, /[0-9]+x[0-9]+/)) wh = substr($0, RSTART, RLENGTH)
      if (match($0, /format 0x[0-9a-fA-F]+/)) {
        f = tolower(substr($0, RSTART + 7, RLENGTH - 7))
        codec = (f in fmt) ? fmt[f] : f
      }
    }
    /\] Format .* chosen by get_format/ && impl == "" {
      if (match($0, /\[[a-z0-9_]+ @/)) impl = substr($0, RSTART + 1, RLENGTH - 3)
    }
    /Using .* renderer/ && rend == "" {
      if (match($0, /Using .* renderer/)) rend = substr($0, RSTART + 6, RLENGTH - 15)
    }
    index($0, q " failed to initialize") {
      if (match($0, q "[^" q "]+" q)) {
        name = substr($0, RSTART + 1, RLENGTH - 2)
        if (index("," failed ",", "," name ",") == 0) failed = failed (failed == "" ? "" : ",") name
      }
    }
    inb && /Incoming frame rate from network:/ { fi = after("network:") }
    inb && /Decoding frame rate:/ { fd = after("rate:") }
    inb && /Rendering frame rate:/ { fr = after("rate:") }
    inb && /Host processing latency/ { hl = hostavg() }
    inb && /Frames dropped by your network connection:/ { nd = after("connection:") }
    inb && /Frames dropped due to network jitter:/ { jd = after("jitter:") }
    inb && /Average network latency:/ { rtt = after("latency:") }
    inb && /Average decoding time:/ { dt = after("time:") }
    inb && /Average frame queue delay:/ { qd = after("delay:") }
    inb && /Average rendering time/ { rt = after("latency):") }
    END {
      OFS = "\t"
      dec = "impl=" impl " renderer=" rend (failed == "" ? "" : " failed=" failed)
      if (impl == "" && rend == "") dec = ""
      print wh, fi, fd, fr, hl, nd, jd, rtt, dt, qd, rt, codec, dec
      exit seen ? 0 : 2
    }
  ' "$log" || { echo "streamlab: parse: no Global video stats in $log" >&2; return 2; }
}

addr_of() { # client server-addr: the client address as the server sees it
  remote "$1" "ip -4 route get $2" | awk '{for (i = 1; i < NF; i++) if ($i == "src") {print $(i + 1); exit}}'
}

pull_image() {
  remote "$1" "sudo -n podman pull -q $IMAGE" >/dev/null
}

podman_base() { # prints the common podman run flags
  echo "sudo -n podman run --rm --network host --device /dev/dri"
}

cmd_pair() {
  local server='' client='' saddr=''
  while [ $# -gt 0 ]; do
    case $1 in
      --server) server=$2; shift 2 ;;
      --client) client=$2; shift 2 ;;
      --server-addr) saddr=$2; shift 2 ;;
      *) die "pair: unknown option $1" ;;
    esac
  done
  [ -n "$server" ] && [ -n "$client" ] && [ -n "$saddr" ] \
    || die "pair: --server, --client and --server-addr are required"
  guard "$server" "$client"
  pull_image "$client"

  local pin caddr
  pin=$(printf '%04d' $((RANDOM % 10000)))
  caddr=$(addr_of "$client" "$saddr")
  [ -n "$caddr" ] || die "pair: cannot determine the client address toward $saddr"

  local before
  before=$(clients_on "$server")
  remote "$client" "sudo -n mkdir -p $STATE_DIR/moonlight"
  remote "$client" "$(podman_base) --name streamlab-pair -e QT_QPA_PLATFORM=offscreen -e XDG_CONFIG_HOME=/xdg \
    -v $STATE_DIR/moonlight:/xdg:Z $IMAGE pair $saddr --pin $pin" >/dev/null 2>&1 &
  local pairpid=$!

  local secret=''
  for _ in $(seq 1 30); do
    secret=$(remote "$server" "sudo -n curl -sf --unix-socket $WOLF_SOCK http://localhost/api/v1/pair/pending" \
      | jq -r --arg ip "$caddr" "[$JQ_PENDING_LIST | select($JQ_PENDING_IP == \$ip) | $JQ_PENDING_SECRET] | first // empty" \
      2>/dev/null || true)
    [ -n "$secret" ] && break
    sleep 1
  done
  if [ -z "$secret" ]; then
    kill "$pairpid" 2>/dev/null || true
    die "pair: no pending request from $caddr on the server"
  fi

  jq -n --arg s "$secret" --arg p "$pin" "{$PAIR_BODY_SECRET: \$s, $PAIR_BODY_PIN: \$p}" \
    | remote "$server" "sudo -n curl -sf --unix-socket $WOLF_SOCK -X POST -H 'Content-Type: application/json' -d @- http://localhost/api/v1/pair/client" \
    >/dev/null || { kill "$pairpid" 2>/dev/null || true; die "pair: the server rejected the PIN submission"; }

  # Headless `moonlight pair` never exits after success; the server's client
  # list is the proof, then the container is stopped.
  local paired=''
  for _ in $(seq 1 30); do
    [ "$(clients_on "$server")" -gt "$before" ] && { paired=1; break; }
    sleep 1
  done
  remote "$client" "sudo -n podman stop -t 5 streamlab-pair" >/dev/null 2>&1 || true
  wait "$pairpid" 2>/dev/null || true
  [ -n "$paired" ] || die "pair: the server never listed the new client"
  echo "streamlab: paired $client with $server"
}

clients_on() { # server: number of paired clients
  remote "$1" "sudo -n curl -sf --unix-socket $WOLF_SOCK http://localhost/api/v1/clients" | jq '.clients | length'
}

# Writes the eglfs KMS config pinning the card that has a connected connector.
ensure_kms_config() {
  remote "$1" "sudo -n sh -s" <<EOF || die "no connected connector on $1 (is the dummy plug in?)"
set -eu
card=
for s in /sys/class/drm/card[0-9]*-*/status; do
  [ -r "\$s" ] || continue
  if [ "\$(cat "\$s")" = connected ]; then
    d=\${s%/status}
    card=\${d##*/}
    card=\${card%%-*}
    break
  fi
done
[ -n "\$card" ] || exit 1
mkdir -p $STATE_DIR
printf '{"device":"/dev/dri/%s","hwcursor":false,"pbuffers":true,"outputs":[]}\n' "\$card" > $STATE_DIR/kms.json
EOF
}

# shellcheck disable=SC2016
SAMPLER='if command -v nvidia-smi >/dev/null 2>&1; then
  exec nvidia-smi --query-gpu=utilization.encoder,utilization.gpu --format=csv,noheader,nounits -lms 1000
fi
while :; do
  for f in /sys/class/drm/card*/device/gpu_busy_percent; do
    [ -r "$f" ] && { cat "$f"; break; }
  done
  sleep 1
done'

mean_first_field() {
  awk -F, '$1 ~ /^[ ]*[0-9.]+[ ]*$/ {s += $1; n++} END {if (n) printf "%.1f", s / n}' "$1"
}

cmd_run() {
  local server='' saddr='' client='' app='' codec=HEVC res=1920x1080 fps=60
  local bitrate=20000 secs=30 runs=3 variant=baseline out='' label=''
  local resumes=1 gap=2
  while [ $# -gt 0 ]; do
    case $1 in
      --server) server=$2; shift 2 ;;
      --server-addr) saddr=$2; shift 2 ;;
      --client) client=$2; shift 2 ;;
      --app) app=$2; shift 2 ;;
      --codec) codec=$2; shift 2 ;;
      --res) res=$2; shift 2 ;;
      --fps) fps=$2; shift 2 ;;
      --bitrate) bitrate=$2; shift 2 ;;
      --secs) secs=$2; shift 2 ;;
      --runs) runs=$2; shift 2 ;;
      --resumes) resumes=$2; shift 2 ;;
      --gap) gap=$2; shift 2 ;;
      --variant) variant=$2; shift 2 ;;
      --out) out=$2; shift 2 ;;
      --label) label=$2; shift 2 ;;
      *) die "run: unknown option $1" ;;
    esac
  done
  [ -n "$server" ] && [ -n "$saddr" ] && [ -n "$client" ] && [ -n "$app" ] \
    || die "run: --server, --server-addr, --client and --app are required"
  case $resumes in '' | *[!0-9]* | 0) die "run: --resumes must be a positive integer" ;; esac
  case $gap in '' | *[!0-9]*) die "run: --gap must be a whole number of seconds" ;; esac
  [ -n "$out" ] || out=results/$(date -u +%Y%m%dT%H%M%SZ)-$variant.tsv
  mkdir -p "$(dirname "$out")" results/logs

  guard "$server" "$client"
  pull_image "$client"
  ensure_kms_config "$client"

  local cdi=''
  if remote "$client" 'test -e /var/run/cdi/nvidia.yaml'; then
    cdi='--device nvidia.com/gpu=all'
  fi

  if [ ! -s "$out" ]; then
    printf 'ts\thost\tvariant\tworkload\trun\tcodec_req\tbitrate_kbps\t%s\tgpu_busy\thot_thread_pct\treverted\n' \
      "$PARSE_COLS" >"$out"
  fi

  local n k id ts log side row gpu samplerpid
  for n in $(seq 1 "$runs"); do
    guard "$server" "$client"
    # Each stream is stopped by signal, which leaves the app running on the
    # host; the next stream to the same app is then a resume. One quit ends
    # the run.
    for k in $(seq 1 "$resumes"); do
      id=$n
      [ "$resumes" -eq 1 ] || id=$n.$k
      ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
      log=results/logs/$(date -u +%Y%m%dT%H%M%SZ)-$variant-$id.log
      side=${log%.log}.gpu

      remote "$server" "timeout -s TERM $((secs + 10)) sh -s" <<<"$SAMPLER" >"$side" 2>/dev/null &
      samplerpid=$!

      remote "$client" "timeout -s TERM -k 15 $secs $(podman_base) $cdi \
        -e QT_QPA_EGLFS_KMS_CONFIG=/kms.json -e XDG_CONFIG_HOME=/xdg \
        -v $STATE_DIR/kms.json:/kms.json:ro,Z -v $STATE_DIR/moonlight:/xdg:Z \
        $IMAGE stream $saddr '$app' --resolution $res --fps $fps --bitrate $bitrate \
        --video-codec $codec --video-decoder hardware --display-mode fullscreen --no-quit-after" \
        2>"$log" >/dev/null || true

      kill "$samplerpid" 2>/dev/null || true
      wait "$samplerpid" 2>/dev/null || true

      row=$(parse "$log" | tail -n 1) || echo "streamlab: run $id produced no stats block" >&2
      row=${row:-$(printf '\t\t\t\t\t\t\t\t\t\t\t\t')}
      gpu=$(mean_first_field "$side")
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t\t\n' \
        "$ts" "${label:-$server}" "$variant" "$app" "$id" "$codec" "$bitrate" "$row" "$gpu" >>"$out"
      echo "streamlab: run $id recorded in $out"

      [ "$k" -eq "$resumes" ] || sleep "$gap"
    done

    remote "$client" "$(podman_base) -e QT_QPA_PLATFORM=offscreen -e XDG_CONFIG_HOME=/xdg \
      -v $STATE_DIR/moonlight:/xdg:Z $IMAGE quit $saddr" >/dev/null 2>&1 \
      || echo "streamlab: run $n: quit on $server failed" >&2

    guard "$server" "$client"
  done
}

# Runs on the Wolf host through `sh -s -- VERB ARGS...`; sock and pdata are
# prepended by game_remote. Needs podman, sudo, curl and jq on the host.
read -r -d '' GAME_REMOTE <<'EOF' || true
set -u
verb=$1
shift
shots=${TMPDIR:-/tmp}
get() { sudo -n curl -sf --unix-socket "$sock" "http://localhost/api/v1/$1"; }
post() { sudo -n curl -s --unix-socket "$sock" -X POST -H 'Content-Type: application/json' -d @- "http://localhost/api/v1/$1"; }
exe_comm() { comm=$(printf %.15s "$1"); }
steam_container() {
  c=$(sudo -n podman ps --format '{{.Names}}' | grep -m1 '^WolfSteam_') || { echo "no WolfSteam container" >&2; exit 1; }
}
steam_up() { # max-wait-secs: sets c, pid and envs once Steam and its web helper run
  steam_container
  i=0
  until pid=$(sudo -n podman exec "$c" pgrep -o -x steam) && sudo -n podman exec "$c" pgrep -f steamwebhelper >/dev/null; do
    sleep 5
    i=$((i + 5))
    [ $i -ge "$1" ] && { echo "steam never came up" >&2; exit 1; }
  done
  envs=$(sudo -n podman exec "$c" sh -c "tr '\0' '\n' </proc/$pid/environ" \
    | grep -E '^(DISPLAY|WAYLAND_DISPLAY|GAMESCOPE_WAYLAND_DISPLAY|XDG_RUNTIME_DIR|HOME)=' | tr '\n' ' ')
}
x() { sudo -n podman exec -u retro "$c" sh -c "env $envs $1"; }
gpu() {
  if command -v nvidia-smi >/dev/null; then
    nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits | head -1
  else
    for f in /sys/class/drm/card*/device/gpu_busy_percent; do printf '%s ' "$(cat "$f")"; done
  fi
}
wins() { # focusable windows as appid:comm
  x 'xprop -root GAMESCOPE_FOCUSABLE_WINDOWS' 2>/dev/null | sed 's/.*= //' | tr -d ' ' | tr ',' '\n' \
    | awk 'NR%3==2{a=$0} NR%3==0{print a, $0}' | while read -r a p; do
      printf '%s:%s ' "$a" "$(sudo -n podman exec "$c" cat /proc/"$p"/comm 2>/dev/null)"
    done
}
shot() { # tag
  x "gamescopectl screenshot /tmp/$1.png" >/dev/null 2>&1
  sleep 3
  sudo -n podman cp "$c:/tmp/$1.png" "$shots/$1.png" && sudo -n chmod 644 "$shots/$1.png" && echo "shot $shots/$1.png"
}

case $verb in
  lobby) # profile extra-env image headless WxH: start the profile's first app; unless headless, join the live session
    profile=$1 headless=${4:-0} res=${5:-1920x1080}
    set -e
    if [ "$headless" = 1 ]; then
      sess=$(jq -nc --argjson w "${res%x*}" --argjson h "${res#*x}" '{client_settings: {run_uid: 1000, run_gid: 1000},
        audio_channel_count: 2, video_width: $w, video_height: $h, video_refresh_rate: 60}')
      caps=video/x-raw stopw=false
    else
      sess=$(get sessions | jq -c '.sessions[0]')
      [ "$sess" != null ] || { echo "no session" >&2; exit 1; }
      cid=$(echo "$sess" | jq -r .client_id)
      ui=$(sudo -n podman ps --format '{{.Names}}' | grep -m1 "^Wolf-UI_$cid") || { echo "no Wolf UI container" >&2; exit 1; }
      caps=$(sudo -n podman inspect "$ui" | jq -r '.[0].Config.Env[] | select(startswith("WOLF_VIDEO_BUFFER_CAPS=")) | sub("^WOLF_VIDEO_BUFFER_CAPS=";"")')
      stopw=true
    fi
    runner=$(get profiles | jq -c --arg p "$profile" --arg e "${2:-}" --arg i "${3:-}" '.profiles[] | select(.id==$p) | .apps[0].runner
      | if $e != "" then .env += [$e] else . end | if $i != "" then .image = $i else . end')
    node=$(sudo -n podman inspect wolf | jq -r '.[0].Config.Env[] | select(startswith("WOLF_RENDER_NODE=")) | sub("^WOLF_RENDER_NODE=";"")')
    node=${node:-/dev/dri/renderD128}
    lid=$(jq -nc --argjson s "$sess" --argjson r "$runner" --arg caps "$caps" --arg p "$profile" --arg node "$node" --arg pd "$pdata" --argjson stopw "$stopw" '{
      profile_id: $p, name: "streamlab", multi_user: false, pin: null,
      stop_when_everyone_leaves: $stopw,
      runner_state_folder: ($pd + "/" + $p + "/" + $r.name),
      runner: $r, client_settings: $s.client_settings,
      audio_settings: {channel_count: $s.audio_channel_count},
      video_settings: {width: $s.video_width, height: $s.video_height,
        refresh_rate: $s.video_refresh_rate, wayland_render_node: $node,
        runner_render_node: $node, video_producer_buffer_caps: $caps}}' \
      | post lobbies/create | jq -r .lobby_id)
    if [ "$headless" != 1 ]; then
      jq -nc --arg l "$lid" --arg c "$cid" '{lobby_id: $l, moonlight_session_id: $c}' | post lobbies/join >/dev/null
    fi
    echo "$lid"
    ;;
  stop) # lobby
    jq -nc --arg l "$1" '{lobby_id: $l}' | post lobbies/stop
    echo
    ;;
  status)
    echo "$(sudo -n podman ps --format '{{.Names}}' | tr '\n' ' ')sessions=$(get sessions | jq '.sessions|length')"
    ;;
  sessions)
    get sessions | jq '.sessions|length'
    ;;
  exec) # command: run it as the Steam user, inside the Steam session's environment
    steam_up 10
    # shellcheck disable=SC2086
    printf '%s\n' "$1" | sudo -n podman exec -i -u retro "$c" env $envs sh -s
    ;;
  probe) # appid secs tag baselayer step
    appid=$1 secs=$2 tag=$3 base=$4 step=$5
    steam_up 300
    i=0
    until x 'xprop -root GAMESCOPE_FOCUSED_APP' 2>/dev/null | grep -q '= 769'; do
      sleep 5
      i=$((i + 5))
      [ $i -ge 300 ] && { echo "big picture never focused" >&2; break; }
    done
    sleep 20
    echo "steam up after ~${i}s; launching $appid"
    x "steam steam://rungameid/$appid >/dev/null 2>&1 &"
    t=0 ttff=none gmax=0 forced=no f=
    while [ $t -lt "$secs" ]; do
      sleep "$step"
      t=$((t + step))
      f=$(x 'xprop -root GAMESCOPE_FOCUSED_APP' 2>/dev/null | sed 's/.*= //')
      b=$(x 'xprop -root GAMESCOPECTRL_BASELAYER_APPID' 2>/dev/null | sed 's/.*= //')
      w=$(wins)
      g=$(gpu)
      for v in $g; do [ "$v" -gt "$gmax" ] 2>/dev/null && gmax=$v; done
      [ "$ttff" = none ] && [ "$f" = "$appid" ] && ttff=$t
      echo "t=$t gpu=$g focused=$f base=[$b] wins=$w"
      if [ "$base" = 1 ] && [ "$f" != "$appid" ]; then
        case " $w" in
          *" $appid:"*)
            x "xprop -root -f GAMESCOPECTRL_BASELAYER_APPID 32c -set GAMESCOPECTRL_BASELAYER_APPID $appid"
            forced=yes
            echo "t=$t base layer set to $appid"
            ;;
        esac
      fi
    done
    [ "$f" = "$appid" ] && end=yes || end=no
    echo "result focused=$end ttff_s=$ttff gpu_max=$gmax forced=$forced"
    shot "$tag"
    echo "--- game processes"
    sudo -n podman exec "$c" sh -c "ps -eo etimes,comm | grep -viE 'steam|sh$|ps$|grep|xwayland|gamescope|pipewire|dbus|reaper|sleep|tr$|cat$' | tail -8"
    ;;
  diag) # appid exe tag: why a running game has no focusable window
    appid=$1 exe=$2 tag=$3
    steam_up 300
    sleep 30
    x "steam steam://rungameid/$appid >/dev/null 2>&1 &"
    i=0
    exe_comm "$exe"
    until sudo -n podman exec "$c" pgrep -x -- "$comm" >/dev/null; do
      sleep 10
      i=$((i + 10))
      [ $i -ge 900 ] && { echo "$exe never started" >&2; break; }
    done
    echo "$exe up after ${i}s"
    sleep 90
    echo "--- tools"
    sudo -n podman exec -u retro "$c" sh -c 'for t in xwininfo xdotool xlsclients wmctrl xdpyinfo python3 vulkaninfo; do command -v $t >/dev/null && printf "%s " $t; done; echo'
    echo "--- root props"
    x 'xprop -root' 2>/dev/null | grep -E '^GAMESCOPE(_FOCUS|CTRL_BASELAYER)' | cut -c1-200
    echo "--- procs (stat wchan cpu)"
    sudo -n podman exec "$c" ps -eo pid,stat,wchan:20,pcpu,etimes,comm --sort=-pcpu | head -14
    echo "--- gpu procs"
    nvidia-smi --query-compute-apps=pid,process_name,used_memory --format=csv,noheader 2>/dev/null | head
    echo "--- driver"
    nvidia-smi --query-gpu=driver_version --format=csv,noheader 2>/dev/null
    echo "--- focus_info"
    x 'gamescopectl focus_info' >/dev/null 2>&1
    sleep 2
    sudo -n podman logs --since 10s "$c" 2>&1 | tail -25 | cut -c1-200
    echo "--- recent container log errors"
    sudo -n podman logs --since 400s "$c" 2>&1 | grep -iE 'err|fail|vk_|vulkan|dxvk|wine|fatal|crash' | grep -v -i 'steamwebhelper' | tail -25 | cut -c1-220
    shot "$tag"
    ;;
  close) # exe steam-root appid settle upload-wait exe-wait: wait for the exe, let it run settle seconds, TERM it, wait for the cloud upload
    exe=$1 root=$2 appid=$3 settle=$4 upload=$5 waitmax=$6
    c=$(sudo -n podman ps --format '{{.Names}}' | grep -m1 '^WolfSteam_') || { echo "no WolfSteam container; nothing to close"; exit 0; }
    exe_comm "$exe"
    i=0
    until sudo -n podman exec "$c" pgrep -x -- "$comm" >/dev/null; do
      [ $i -ge "$waitmax" ] && { echo "$exe not running after ${i}s"; exit 0; }
      sleep 10
      i=$((i + 10))
    done
    echo "$exe up after ${i}s"
    sleep "$settle"
    sudo -n podman exec -u retro "$c" pkill -TERM -x -- "$comm"
    i=0
    while sudo -n podman exec "$c" pgrep -x -- "$comm" >/dev/null; do
      sleep 2
      i=$((i + 2))
      [ $i -ge 60 ] && { echo "$exe still running ${i}s after TERM" >&2; exit 1; }
    done
    echo "$exe exited ${i}s after TERM"
    sleep "$upload"
    if [ -n "$root" ]; then
      sudo -n grep -a -h "$appid" "$root/logs/cloud_log.txt" | tail -2 | cut -c1-150
    fi
    ;;
  *)
    echo "unknown verb $verb" >&2
    exit 2
    ;;
esac
EOF

GAME_STATE=${STREAMLAB_STATE:-${TMPDIR:-/tmp}/streamlab-game}
WOLF_PROFILE_DATA=/var/srv/wolf/profile-data
GAME_MARGIN=900
GAME_SELF=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")

shq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

game_remote() { # host verb args...
  local h=$1 verb=$2 a args=''
  shift 2
  for a in "$@"; do args+=" $(shq "$a")"; done
  { printf 'sock=%s\npdata=%s\n' "$WOLF_SOCK" "$WOLF_PROFILE_DATA"; printf '%s\n' "$GAME_REMOTE"; } \
    | remote "$h" "sh -s -- $verb$args"
}

game_hold() { # starts the Wolf UI stream in the background and prints the lobby id
  guard "$server" "$client"
  mkdir -p "$GAME_STATE"
  nohup "$GAME_SELF" run --server "$server" --server-addr "$saddr" --client "$client" --app "$app" \
    --res "$res" --fps "$fps" --bitrate "$bitrate" --secs "$1" --runs 1 --variant "game-${tag:-hold}" \
    --out "$GAME_STATE/hold.tsv" >"$GAME_STATE/hold.log" 2>&1 &
  echo $! >"$GAME_STATE/hold.pid"
  local n=0
  for _ in $(seq 1 60); do
    n=$(game_remote "$server" sessions 2>/dev/null || echo 0)
    [ "${n:-0}" -ge 1 ] && break
    sleep 3
  done
  [ "${n:-0}" -ge 1 ] || { game_release; die "game: the stream never opened a session on $server"; }
  sleep 15
  game_remote "$server" lobby "$profile" "$env" "$image" 0 "$res"
}

image_repo() { # IMAGE without its tag, leaving a registry port alone
  case ${IMAGE##*/} in
    *:*) printf '%s' "${IMAGE%:*}" ;;
    *) printf '%s' "$IMAGE" ;;
  esac
}

game_release() { # stops the background stream and any leftover client container
  if [ -f "$GAME_STATE/hold.pid" ]; then
    kill "$(cat "$GAME_STATE/hold.pid")" 2>/dev/null || true
    rm -f "$GAME_STATE/hold.pid"
  fi
  if [ -n "$client" ]; then
    remote "$client" "sudo -n podman ps -q --filter ancestor=$(image_repo) | xargs -r sudo -n podman stop -t 5" >/dev/null 2>&1 || true
    [ -z "$saddr" ] || remote "$client" "$(podman_base) -e QT_QPA_PLATFORM=offscreen -e XDG_CONFIG_HOME=/xdg \
      -v $STATE_DIR/moonlight:/xdg:Z $IMAGE quit $saddr" >/dev/null 2>&1 || true
  fi
}

# Closes the game cleanly before the lobby goes: a game killed with its lobby
# leaves a cloud-save session pending and the next launch elsewhere stalls on it.
game_stop() {
  if [ -n "$exe" ]; then
    game_remote "$server" close "$exe" "$steam_root" "$appid" "$settle" "$upload_wait" "$exe_wait" \
      || die "stop: $exe did not exit cleanly; the lobby and stream are left running"
  elif [ -z "$force" ]; then
    die "stop: --exe is required so the game is closed before its lobby stops (or --force)"
  fi
  [ -z "$lobby" ] || game_remote "$server" stop "$lobby" >/dev/null
  game_release
  sleep 10
  echo "streamlab: $(game_remote "$server" status)"
}

game_run() {
  local lid rc=0 out ts live
  if [ -n "$headless" ]; then
    lid=$(game_remote "$server" lobby "$profile" "$env" "$image" 1 "$res") || die "run: could not start the lobby"
  else
    lid=$(game_hold $((secs + GAME_MARGIN))) || die "run: could not start the lobby"
  fi
  echo "streamlab: lobby $lid"
  live=$(mktemp)
  set +e
  game_remote "$server" probe "$appid" "$secs" "$tag" "$baselayer" "$interval" | tee "$live"
  rc=${PIPESTATUS[0]}
  set -e
  out=$(cat "$live")
  rm -f "$live"
  mkdir -p "$shot_dir" "$(dirname "$results")"
  local shot
  shot=$(printf '%s\n' "$out" | awk '$1 == "shot" {print $2}')
  [ -z "$shot" ] || remote "$server" "cat '$shot'" >"$shot_dir/$tag.png" 2>/dev/null || true
  [ -s "$results" ] || printf 'ts\thost\tappid\ttag\tfocused\tttff_s\tgpu_max\tforced\n' >"$results"
  ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  printf '%s\n' "$out" | awk -v ts="$ts" -v h="${label:-$server}" -v a="$appid" -v t="$tag" -F'[ =]' '
    $1 == "result" {printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", ts, h, a, t, $3, $5, $7, $9; ok = 1}
    END {exit ok ? 0 : 1}' >>"$results" || echo "streamlab: run: no result line from the probe" >&2
  lobby=$lid
  game_stop || rc=1
  return "$rc"
}

cmd_game() {
  local verb=${1:-}
  [ $# -gt 0 ] && shift
  local server='' saddr='' client='' profile='' env='' image='' appid='' exe='' steam_root=''
  local secs=240 tag='' interval=10 baselayer=0 lobby='' settle=60 upload_wait=30 exe_wait=600 force='' headless=''
  local app='Wolf UI' res=1920x1080 fps=60 bitrate=20000 results=results/game.tsv
  local shot_dir=results/logs label='' cmd=''
  while [ $# -gt 0 ]; do
    case $1 in
      --server) server=$2; shift 2 ;;
      --server-addr) saddr=$2; shift 2 ;;
      --client) client=$2; shift 2 ;;
      --profile) profile=$2; shift 2 ;;
      --env) env=$2; shift 2 ;;
      --image) image=$2; shift 2 ;;
      --appid) appid=$2; shift 2 ;;
      --exe) exe=$2; shift 2 ;;
      --steam-root) steam_root=$2; shift 2 ;;
      --secs) secs=$2; shift 2 ;;
      --tag) tag=$2; shift 2 ;;
      --interval) interval=$2; shift 2 ;;
      --baselayer) baselayer=1; shift ;;
      --lobby) lobby=$2; shift 2 ;;
      --settle) settle=$2; shift 2 ;;
      --upload-wait) upload_wait=$2; shift 2 ;;
      --exe-wait) exe_wait=$2; shift 2 ;;
      --headless) headless=1; shift ;;
      --force) force=1; shift ;;
      --app) app=$2; shift 2 ;;
      --res) res=$2; shift 2 ;;
      --fps) fps=$2; shift 2 ;;
      --bitrate) bitrate=$2; shift 2 ;;
      --results) results=$2; shift 2 ;;
      --shot-dir) shot_dir=$2; shift 2 ;;
      --label) label=$2; shift 2 ;;
      --) shift; cmd=$*; break ;;
      *) die "game $verb: unknown option $1" ;;
    esac
  done
  tag=${tag:-$appid}
  uint() { # option name and value: a whole number
    case $2 in '' | *[!0-9]*) die "game $verb: --$1 must be a whole number" ;; esac
  }
  uint secs "$secs"
  uint interval "$interval"
  [ "$interval" -gt 0 ] || die "game $verb: --interval must be at least 1"
  uint settle "$settle"
  uint upload-wait "$upload_wait"
  uint exe-wait "$exe_wait"
  case $tag in *[!A-Za-z0-9._-]*) die "game $verb: --tag may only hold letters, digits, . _ and -" ;; esac
  case $res in [0-9]*x[0-9]*) ;; *) die "game $verb: --res must be WxH" ;; esac
  need() { # option names that must be non-empty, as "name=value" pairs
    local p
    for p in "$@"; do
      [ -n "${p#*=}" ] || die "game $verb: --${p%%=*} is required"
    done
  }
  case $verb in
    lobby) need server="$server" profile="$profile"; game_remote "$server" lobby "$profile" "$env" "$image" "${headless:-0}" "$res" ;;
    exec)
      need server="$server"
      [ -n "$cmd" ] || die "game exec: a command after -- is required"
      game_remote "$server" exec "$cmd"
      ;;
    probe) need server="$server" appid="$appid"; game_remote "$server" probe "$appid" "$secs" "$tag" "$baselayer" "$interval" ;;
    diag) need server="$server" appid="$appid" exe="$exe"; game_remote "$server" diag "$appid" "$exe" "$tag" ;;
    close)
      need server="$server" exe="$exe"
      game_remote "$server" close "$exe" "$steam_root" "$appid" "$settle" "$upload_wait" "$exe_wait"
      ;;
    hold)
      need server="$server" server-addr="$saddr" client="$client" profile="$profile"
      game_hold "$secs"
      ;;
    stop)
      need server="$server" lobby="$lobby"
      game_stop
      ;;
    run)
      need server="$server" profile="$profile" appid="$appid"
      [ -n "$headless" ] || need server-addr="$saddr" client="$client"
      [ -n "$exe" ] || [ -n "$force" ] || die "run: --exe is required so the game is closed before its lobby stops (or --force)"
      game_run
      ;;
    *) echo "usage: streamlab game lobby|exec|probe|diag|close|hold|stop|run OPTIONS" >&2; exit 2 ;;
  esac
}

main() {
  local sub=${1:-}
  [ $# -gt 0 ] && shift
  case $sub in
    guard) guard "$@" ;;
    pair) cmd_pair "$@" ;;
    run) cmd_run "$@" ;;
    game) cmd_game "$@" ;;
    parse) parse "$@" ;;
    *) echo "usage: streamlab guard HOST... | pair | run | game | parse LOG" >&2; exit 2 ;;
  esac
}

main "$@"
